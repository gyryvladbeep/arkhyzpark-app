{
  "expo": {
    "name": "Архызпарк",
    "slug": "arkhyzpark-app",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arkhyzpark",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ru.arkhyzpark.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.arkhyzpark.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Архызпарк",
      "backgroundColor": "#0A0E13"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Архызпарк записывает трассы, скорость и перепад высоты во время катания и походов.",
          "locationAlwaysAndWhenInUsePermission": "Разрешите доступ «Всегда», чтобы запись катания продолжалась, когда телефон лежит в кармане с выключенным экраном.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "Разрешите доступ «Всегда», чтобы запись катания продолжалась с выключенным экраном."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3D9BFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0E13"
  }
}
